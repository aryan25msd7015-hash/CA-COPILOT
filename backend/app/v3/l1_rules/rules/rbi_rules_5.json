[
  {
    "rule_id": "rbi_ctr_above_10l",
    "title": "Single cash-equivalent transfer above 10 lakh",
    "severity": "critical",
    "all_of": [
      { "field": "amount", "op": "gt", "value": 1000000 }
    ]
  },
  {
    "rule_id": "rbi_structuring_24h",
    "title": "Structuring over 24-hour window",
    "severity": "high",
    "all_of": [
      { "field": "total_amount_24h", "op": "gt", "value": 1000000 },
      { "field": "txn_count_24h", "op": "gte", "value": 3 },
      { "field": "amount", "op": "lt", "value": 1000000 }
    ]
  },
  {
    "rule_id": "rbi_weekend_high_value",
    "title": "Weekend high-value transfer",
    "severity": "high",
    "all_of": [
      { "predicate": "is_weekend" },
      { "field": "amount", "op": "gt", "value": 250000 }
    ]
  },
  {
    "rule_id": "rbi_new_beneficiary",
    "title": "High value to new beneficiary",
    "severity": "critical",
    "all_of": [
      { "field": "is_new_beneficiary", "op": "eq", "value": true },
      { "field": "amount", "op": "gt", "value": 100000 }
    ]
  },
  {
    "rule_id": "rbi_cross_border_kyc_mismatch",
    "title": "Cross border transfer with KYC mismatch",
    "severity": "high",
    "all_of": [
      { "field": "is_international", "op": "eq", "value": true },
      { "field": "pan_gstin_mismatch", "op": "eq", "value": true }
    ]
  }
]
